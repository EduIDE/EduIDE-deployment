{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EduIDE Environment",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "eduide.dev/v1" },
    "kind": { "const": "Environment" },
    "metadata": {
      "type": "object",
      "required": ["name", "tier"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "displayName": { "type": "string" },
        "tier": { "enum": ["test", "staging", "production"] },
        "owners": { "type": "array", "items": { "type": "string" } }
      }
    },
    "spec": {
      "type": "object",
      "required": ["cluster", "namespace", "platform", "hosts", "gateway", "keycloak", "branding"],
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "string",
          "description": "Must match a file in clusters/. Asserted against the kubeconfig at deploy time."
        },
        "namespace": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "platform": {
          "type": "object",
          "required": ["chartVersion", "channel"],
          "additionalProperties": false,
          "properties": {
            "chartVersion": { "type": "string" },
            "channel": {
              "enum": ["release", "main", "pinned"],
              "description": "release pins images to the chart appVersion; main follows an immutable main-<sha> tag; pinned uses spec.imageTag."
            }
          }
        },
        "imageTag": {
          "type": "string",
          "description": "One tag for every EduIDE image in this environment. Defaults to latest."
        },
        "hosts": {
          "type": "object",
          "required": ["baseHost", "landing"],
          "additionalProperties": false,
          "properties": {
            "baseHost": { "type": "string" },
            "landing": { "type": "string" },
            "service": { "type": "string", "description": "Defaults to service.<landing>" },
            "instance": { "type": "string", "description": "Defaults to instance.<landing>" },
            "wildcardPrefixes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "gateway": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["shared", "local", "none"] },
            "listenerPrefix": {
              "type": "string",
              "description": "Derives the four sectionNames. NOT necessarily the landing host: staging uses 'staging' and production uses 'prod'."
            }
          }
        },
        "keycloak": {
          "type": "object",
          "required": ["realm", "clientId"],
          "additionalProperties": false,
          "properties": {
            "realm": { "type": "string" },
            "clientId": { "type": "string" }
          }
        },
        "branding": {
          "type": "object",
          "required": ["appName", "infoTitle"],
          "additionalProperties": false,
          "properties": {
            "appName": { "type": "string" },
            "infoTitle": { "type": "string" },
            "footerVersion": { "type": "string" }
          }
        },
        "preloadApps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDE images to pre-pull on every node. Defaults to the standard app set."
        },
        "addons": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sharedCache": { "type": "boolean" },
            "garbageCollector": { "type": "boolean" }
          }
        },
        "values": {
          "type": "object",
          "description": "Free-form Helm values, merged last. Use sparingly: anything that appears here for more than one environment belongs in environments/_base.yaml or as a first-class field."
        }
      }
    }
  }
}
