{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EduIDE Cluster",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "eduide.dev/v1" },
    "kind": { "const": "Cluster" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "displayName": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["storageClassName", "runner"],
      "additionalProperties": false,
      "properties": {
        "apiServerUrl": {
          "type": "string",
          "description": "Asserted against the kubeconfig before every deploy. Empty means the assertion is skipped, which should be temporary."
        },
        "storageClassName": { "type": "string" },
        "gatewayClassName": { "type": "string" },
        "sharedGateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" }
          }
        },
        "loadBalancerIP": { "type": "string" },
        "runner": {
          "type": "string",
          "description": "Runner label for deploy jobs. Deploying needs to reach the API server, so this is per-cluster rather than one answer for all."
        },
        "bootstrapEnvironment": { "type": "string" }
      }
    }
  }
}
